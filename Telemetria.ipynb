
    "# SISTEMA DE MONITORAMENTO E ANÁLISE DE UMA NAVE\n",
    "\n",
    "\n",
    "#  ENTRADA DE DADOS\n",
    "\n",
    "print(\"        SISTEMA DE MONITORAMENTO DA NAVE\")\n",
    "\n",
    "\n",
    "temperatura_interna = float(\n",
    "    input(\"Temperatura interna (°C): \")\n",
    ")\n",
    "\n",
    "temperatura_externa = float(\n",
    "    input(\"Temperatura externa (°C): \")\n",
    ")\n",
    "\n",
    "integridade = int(\n",
    "    input(\"Integridade estrutural (0 = danificado / 1 = intacto): \")\n",
    ")\n",
    "\n",
    "nivel_energia = float(\n",
    "    input(\"Nivel de energia da bateria (%): \")\n",
    ")\n",
    "\n",
    "pressao_tanques = float(\n",
    "    input(\"Pressao dos tanques (N/m²): \")\n",
    ")\n",
    "\n",
    "status_modulos = int(\n",
    "    input(\"Status dos modulos (0 = falha / 1 = funcionando): \")\n",
    ")\n",
    "\n",
    "\n",
    "#  LIMITES DE SEGURANÇA\n",
    "\n",
    "limite_temperatura_interna = 35\n",
    "limite_temperatura_externa = 45\n",
    "limite_nivel_energia = 40\n",
    "limite_pressao_tanques = 400\n",
    "\n",
    "\n",
    "#  VERIFICAÇÃO DA DECOLAGEM\n",
    "\n",
    "def verifica_decolagem():\n",
    "\n",
    "    if temperatura_interna > limite_temperatura_interna:\n",
    "        return \"DECOLAGEM ABORTADA: Temperatura interna muito alta.\"\n",
    "\n",
    "    if temperatura_externa > limite_temperatura_externa:\n",
    "        return \"DECOLAGEM ABORTADA: Temperatura externa muito alta.\"\n",
    "\n",
    "    if integridade == 0:\n",
    "        return \"DECOLAGEM ABORTADA: Estrutura danificada.\"\n",
    "\n",
    "    if nivel_energia < limite_nivel_energia:\n",
    "        return \"DECOLAGEM ABORTADA: Nivel de energia insuficiente.\"\n",
    "\n",
    "    if pressao_tanques < limite_pressao_tanques:\n",
    "        return \"DECOLAGEM ABORTADA: Pressao dos tanques baixa.\"\n",
    "\n",
    "    if status_modulos == 0:\n",
    "        return \"DECOLAGEM ABORTADA: Modulos criticos com falha.\"\n",
    "\n",
    "    return \"PRONTO PARA DECOLAR\"\n",
    "\n",
    "\n",
    "#  ANÁLISE DE ANOMALIAS\n",
    "\n",
    "def analise_assistida():\n",
    "\n",
    "    anomalias = []\n",
    "\n",
    "    if temperatura_interna > limite_temperatura_interna:\n",
    "        anomalias.append(\n",
    "            \"Temperatura interna acima do limite seguro.\"\n",
    "        )\n",
    "\n",
    "    if temperatura_externa > limite_temperatura_externa:\n",
    "        anomalias.append(\n",
    "            \"Temperatura externa acima do limite seguro.\"\n",
    "        )\n",
    "\n",
    "    if integridade == 0:\n",
    "        anomalias.append(\n",
    "            \"Integridade estrutural comprometida.\"\n",
    "        )\n",
    "\n",
    "    if nivel_energia < limite_nivel_energia:\n",
    "        anomalias.append(\n",
    "            \"Nivel de energia abaixo do limite seguro.\"\n",
    "        )\n",
    "\n",
    "    if pressao_tanques < limite_pressao_tanques:\n",
    "        anomalias.append(\n",
    "            \"Pressao dos tanques abaixo do limite seguro.\"\n",
    "        )\n",
    "\n",
    "    if status_modulos == 0:\n",
    "        anomalias.append(\n",
    "            \"Modulo critico apresenta falha.\"\n",
    "        )\n",
    "\n",
    "    return anomalias\n",
    "\n",
    "\n",
    "#  CÁLCULO DA AUTONOMIA\n",
    "\n",
    "def calcular_autonomia():\n",
    "\n",
    "    # Capacidade total da bateria\n",
    "    capacidade_total = 200\n",
    "\n",
    "    # Quantidade de energia disponível\n",
    "    energia_disponivel = (\n",
    "        capacidade_total * (nivel_energia / 100)\n",
    "    )\n",
    "\n",
    "    # Consumo básico\n",
    "    consumo = 50\n",
    "\n",
    "    # Perdas básicas\n",
    "    perdas = 15\n",
    "\n",
    "\n",
    "    # Temperatura interna elevada\n",
    "    if temperatura_interna > 30:\n",
    "        consumo += 10\n",
    "\n",
    "\n",
    "    # Temperatura externa elevada\n",
    "    if temperatura_externa > 35:\n",
    "        consumo += 10\n",
    "\n",
    "\n",
    "    # Falha em módulo\n",
    "    if status_modulos == 0:\n",
    "        consumo += 20\n",
    "\n",
    "\n",
    "    # Pressão abaixo do ideal\n",
    "    if pressao_tanques < 500:\n",
    "        perdas += 10\n",
    "\n",
    "\n",
    "    # Cálculo final\n",
    "    autonomia = (\n",
    "        energia_disponivel\n",
    "        - consumo\n",
    "        - perdas\n",
    "    )\n",
    "\n",
    "    # Impede autonomia negativa\n",
    "    if autonomia < 0:\n",
    "        autonomia = 0\n",
    "\n",
    "    return autonomia\n",
    "\n",
    "\n",
    "#  CÁLCULO DO ÍNDICE DE RISCO\n",
    "\n",
    "def calcular_indice_risco():\n",
    "\n",
    "    indice = 0\n",
    "\n",
    "    motivos = []\n",
    "\n",
    "\n",
    "    # TEMPERATURA INTERNA\n",
    "\n",
    "    if temperatura_interna > 35:\n",
    "\n",
    "        indice += 25\n",
    "\n",
    "        motivos.append(\n",
    "            \"Temperatura interna muito alta (+25 )\"\n",
    "        )\n",
    "\n",
    "    elif temperatura_interna > 30:\n",
    "\n",
    "        indice += 10\n",
    "\n",
    "        motivos.append(\n",
    "            \"Temperatura interna acima do normal (+10 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # TEMPERATURA EXTERNA\n",
    "\n",
    "    if temperatura_externa > 45:\n",
    "\n",
    "        indice += 25\n",
    "\n",
    "        motivos.append(\n",
    "            \"Temperatura externa muito alta (+25 )\"\n",
    "        )\n",
    "\n",
    "    elif temperatura_externa > 35:\n",
    "\n",
    "        indice += 10\n",
    "\n",
    "        motivos.append(\n",
    "            \"Temperatura externa acima do normal (+10 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # INTEGRIDADE ESTRUTURAL\n",
    "\n",
    "    if integridade == 0:\n",
    "\n",
    "        indice += 40\n",
    "\n",
    "        motivos.append(\n",
    "            \"Integridade estrutural comprometida (+40 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # NÍVEL DE ENERGIA\n",
    "\n",
    "    if nivel_energia < 40:\n",
    "\n",
    "        indice += 25\n",
    "\n",
    "        motivos.append(\n",
    "            \"Nivel de energia critico (+25 )\"\n",
    "        )\n",
    "\n",
    "    elif nivel_energia < 60:\n",
    "\n",
    "        indice += 10\n",
    "\n",
    "        motivos.append(\n",
    "            \"Nivel de energia abaixo do recomendado (+10 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # PRESSÃO DOS TANQUES\n",
    "\n",
    "    if pressao_tanques < 400:\n",
    "\n",
    "        indice += 30\n",
    "\n",
    "        motivos.append(\n",
    "            \"Pressao dos tanques muito baixa (+30 )\"\n",
    "        )\n",
    "\n",
    "    elif pressao_tanques < 500:\n",
    "\n",
    "        indice += 10\n",
    "\n",
    "        motivos.append(\n",
    "            \"Pressao dos tanques abaixo do ideal (+10 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # MÓDULOS\n",
    "\n",
    "    if status_modulos == 0:\n",
    "\n",
    "        indice += 30\n",
    "\n",
    "        motivos.append(\n",
    "            \"Modulo critico com falha (+30 )\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # LIMITE MÁXIMO\n",
    "\n",
    "    if indice > 100:\n",
    "        indice = 100\n",
    "\n",
    "\n",
    "    return indice, motivos\n",
    "\n",
    "\n",
    "#  CLASSIFICAÇÃO DO ÍNDICE DE RISCO\n",
    "\n",
    "def classificar_risco(indice):\n",
    "\n",
    "    if indice <= 20:\n",
    "\n",
    "        return \"BAIXO\"\n",
    "\n",
    "    elif indice <= 50:\n",
    "\n",
    "        return \"MODERADO\"\n",
    "\n",
    "    elif indice <= 80:\n",
    "\n",
    "        return \"ALTO\"\n",
    "\n",
    "    else:\n",
    "\n",
    "        return \"CRITICO\"\n",
    "\n",
    "\n",
    "#  EXECUÇÃO DA VERIFICAÇÃO\n",
    "\n",
    "resultado = verifica_decolagem()\n",
    "\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"              RESULTADO DA DECOLAGEM\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(resultado)\n",
    "\n",
    "\n",
    "#  ANÁLISE DE ANOMALIAS\n",
    "\n",
    "anomalias = analise_assistida()\n",
    "\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"              ANÁLISE DE ANOMALIAS\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "\n",
    "if anomalias:\n",
    "\n",
    "    for anomalia in anomalias:\n",
    "\n",
    "        print(\"⚠\", anomalia)\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\"Nenhuma anomalia identificada.\")\n",
    "\n",
    "\n",
    "#  AUTONOMIA\n",
    "\n",
    "autonomia = calcular_autonomia()\n",
    "\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"              ANÁLISE ENERGÉTICA\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(\n",
    "    f\"Autonomia estimada: {autonomia:.2f} kWh\"\n",
    ")\n",
    "\n",
    "\n",
    "#  ÍNDICE DE RISCO\n",
    "\n",
    "indice_risco, motivos = calcular_indice_risco()\n",
    "\n",
    "classificacao = classificar_risco(indice_risco)\n",
    "\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"              ÍNDICE DE RISCO\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(\n",
    "    f\"Indice de risco: {indice_risco}/100\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Classificacao: {classificacao}\"\n",
    ")\n",
    "\n",
    "\n",
    "# EXPLICAÇÃO DO ÍNDICE DE RISCO\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"          MOTIVOS DO ÍNDICE DE RISCO\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "\n",
    "if motivos:\n",
    "\n",
    "    for motivo in motivos:\n",
    "\n",
    "        print(\"-\", motivo)\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"Nenhum fator aumentou o indice de risco.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# RESUMO FINAL\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 55)\n",
    "print(\"                  RESUMO FINAL\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(\n",
    "    f\"Decisao: {resultado}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Autonomia: {autonomia:.2f} kWh\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Indice de risco: {indice_risco}/100\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Nivel de risco: {classificacao}\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 55)\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
